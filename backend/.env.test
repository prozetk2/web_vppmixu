# Test Environment Variables
# This file is used ONLY for testing, NOT for development or production

# Test Database (SEPARATE from your real database)
DATABASE_URL="postgresql://user:password@localhost:5432/warehouse_test"
DIRECT_URL="postgresql://user:password@localhost:5432/warehouse_test"

# JWT Secret for testing
JWT_SECRET="test-secret-key-do-not-use-in-production"
JWT_EXPIRES_IN="1h"

# Supabase (use test project or mock)
SUPABASE_URL="https://test.supabase.co"
SUPABASE_KEY="test-key"

# Other test configs
NODE_ENV="test"
PORT=3001
