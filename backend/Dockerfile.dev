FROM node:20-alpine

# Install necessary packages
RUN apk add --no-cache openssl libc6-compat

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy prisma schema
COPY prisma ./prisma

# Expose port
EXPOSE 3000

# The actual command will be defined in docker-compose.yml
