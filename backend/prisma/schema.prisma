generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AccountingEntry {
  id            BigInt   @id @default(autoincrement())
  entryDate     DateTime @map("entry_date") @db.Date
  description   String?
  referenceType String?  @map("reference_type")
  referenceId   BigInt?  @map("reference_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  lines AccountingLine[]

  @@map("accounting_entry")
}

model AccountingLine {
  id                BigInt          @id @default(autoincrement())
  accountingEntryId BigInt          @map("accounting_entry_id")
  accountId         BigInt          @map("account_id")
  debit             Decimal?        @default(0)
  credit            Decimal?        @default(0)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  entry   AccountingEntry @relation(fields: [accountingEntryId], references: [id])
  account ChartOfAccount  @relation(fields: [accountId], references: [id])

  @@map("accounting_line")
}

model User {
  id           BigInt    @id @default(autoincrement())
  username     String    @unique
  email        String?   @unique
  passwordHash String?   @map("password_hash")
  fullName     String?   @map("full_name")
  phone        String?
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz

  auditLogs      AuditLog[]
  stockMovements StockMovement[]
  userRoles      UserRole[]

  @@map("app_user")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt?  @map("actor_id")
  action     String?
  targetType String?  @map("target_type")
  targetId   BigInt?  @map("target_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_log")
}

model BankAccount {
  id            BigInt   @id @default(autoincrement())
  storeId       BigInt?  @map("store_id")
  bankName      String?  @map("bank_name")
  accountNumber String?  @map("account_number")
  currency      String?  @default("VND")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  store Store? @relation(fields: [storeId], references: [id])

  @@map("bank_account")
}

model Category {
  id          BigInt  @id @default(autoincrement())
  name        String
  code        String? @unique
  parentId    BigInt? @map("parent_id")
  description String?

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  @@map("category")
}

model ChartOfAccount {
  id       BigInt  @id @default(autoincrement())
  code     String  @unique
  name     String
  parentId BigInt? @map("parent_id")
  type     String?

  parent   ChartOfAccount?  @relation("ChartToChart", fields: [parentId], references: [id])
  children ChartOfAccount[] @relation("ChartToChart")
  lines    AccountingLine[]

  @@map("chart_of_account")
}

model Customer {
  id        BigInt   @id @default(autoincrement())
  code      String?  // Bỏ tạm unique constraint
  name      String
  email     String?
  phone     String?
  address   String?
  taxNumber String?  @map("tax_number")
  
  // Thông tin từ Excel
  customerType    String?  @map("customer_type")        // Loại khách
  branch          String?                               // Chi nhánh tạo
  deliveryArea    String?  @map("delivery_area")        // Khu vực giao hàng
  ward            String?                               // Phường/Xã
  company         String?                               // Công ty
  idNumber        String?  @map("id_number")            // Số CMND/CCCD
  birthDate       DateTime? @map("birth_date") @db.Date // Ngày sinh
  gender          String?                               // Giới tính
  facebook        String?                               // Facebook
  customerGroup   String?  @map("customer_group")       // Nhóm khách hàng
  notes           String?                               // Ghi chú
  creator         String?                               // Người tạo
  lastTransaction DateTime? @map("last_transaction") @db.Date // Ngày giao dịch cuối
  
  // Thống kê tài chính (từ Excel hoặc tự tính)
  debtDays              Int?     @map("debt_days")                    // Số ngày nợ
  currentDebt           Decimal? @map("current_debt")                 // Nợ cần thu hiện tại
  totalSales            Decimal? @map("total_sales")                  // Tổng bán
  totalSalesAfterReturn Decimal? @map("total_sales_after_return")     // Tổng bán trừ trả hàng
  
  // Thông tin bổ sung (giữ lại cho tương lai)
  contactPerson String?  @map("contact_person")      
  position      String?                               
  fax           String?                               
  website       String?                               
  
  // Địa chỉ chi tiết (giữ lại)
  street        String?                               
  district      String?                               
  city          String?                               
  country       String?  @default("Vietnam")          
  postalCode    String?  @map("postal_code")          
  
  // Thông tin ngân hàng (giữ lại)
  bankName      String?  @map("bank_name")            
  bankAccount   String?  @map("bank_account")         
  bankBranch    String?  @map("bank_branch")          
  
  // Thông tin kinh doanh (giữ lại)
  industry      String?                               
  companySize   String?  @map("company_size")         
  
  // Phân loại (giữ lại)
  priority      String?  @default("NORMAL")           
  source        String?                               
  
  // Thông tin tài chính (giữ lại)
  creditLimit   Decimal? @default(0) @map("credit_limit")  
  paymentTerms  String?  @map("payment_terms")        
  
  // Metadata
  active        Boolean  @default(true)               
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  invoices Invoice[]
  orders   Order[]

  @@map("customer")
}

model Inventory {
  id          BigInt   @id @default(autoincrement())
  variantId   BigInt   @map("variant_id")
  warehouseId BigInt   @map("warehouse_id")
  quantity    Decimal  @default(0) @db.Decimal(15, 3)
  reserved    Decimal  @default(0) @db.Decimal(15, 3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, warehouseId])
  @@map("inventory")
}

model Invoice {
  id              BigInt    @id @default(autoincrement())
  invoiceNumber   String?   @unique @map("invoice_number")
  orderId         BigInt?   @map("order_id")
  storeId         BigInt?   @map("store_id")
  customerId      BigInt?   @map("customer_id")
  
  // Branch and order references
  branch          String?   // Chi nhánh
  orderCode       String?   @map("order_code") // Mã đặt hàng
  returnOrderCode String?   @map("return_order_code") // Mã trả hàng
  
  // Customer snapshot (for export without JOIN)
  customerCode    String?   @map("customer_code") // Mã khách hàng
  customerName    String?   @map("customer_name") // Tên khách hàng
  customerEmail   String?   @map("customer_email") // Email
  customerPhone   String?   @map("customer_phone") // Điện thoại
  customerAddress String?   @map("customer_address") // Địa chỉ
  customerArea    String?   @map("customer_area") // Khu vực
  customerWard    String?   @map("customer_ward") // Phường/Xã
  customerDob     DateTime? @map("customer_dob") @db.Timestamptz // Ngày sinh
  
  // Sales info
  priceList       String?   @map("price_list") // Bảng giá
  seller          String?   // Người bán
  salesChannel    String?   @map("sales_channel") // Kênh bán
  creator         String?   // Người tạo
  notes           String?   // Ghi chú
  
  // Financial fields
  totalAmount     Decimal?  @map("total_amount") // Tổng tiền hàng
  discountAmount  Decimal?  @default(0) @map("discount_amount") // Giảm giá hóa đơn
  amountDue       Decimal?  @map("amount_due") // Khách cần trả
  amountPaid      Decimal?  @default(0) @map("amount_paid") // Khách đã trả
  cashAmount      Decimal?  @default(0) @map("cash_amount") // Tiền mặt
  cardAmount      Decimal?  @default(0) @map("card_amount") // Thẻ
  walletAmount    Decimal?  @default(0) @map("wallet_amount") // Ví
  transferAmount  Decimal?  @default(0) @map("transfer_amount") // Chuyển khoản
  taxAmount       Decimal?  @map("tax_amount")
  
  // Status fields
  status          String?   @default("COMPLETED") // COMPLETED, CANCELLED
  eInvoiceStatus  String?   @map("einvoice_status") // Trạng thái HĐĐT
  paymentMethod   String?   @map("payment_method") // Phương thức thanh toán
  
  // Timestamps
  issuedAt        DateTime? @map("issued_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  order     Order?            @relation(fields: [orderId], references: [id])
  store     Store?            @relation(fields: [storeId], references: [id])
  customer  Customer?         @relation(fields: [customerId], references: [id])
  eInvoices InvoiceEInvoice[]
  items     InvoiceItem[]

  @@map("invoice")
}

model InvoiceItem {
  id              BigInt    @id @default(autoincrement())
  invoiceId       BigInt    @map("invoice_id")
  productCode     String?   @map("product_code") // Mã hàng
  barcode         String?   // Mã vạch
  productName     String?   @map("product_name") // Tên hàng
  brand           String?   // Thương hiệu
  unit            String?   // ĐVT
  notes           String?   // Ghi chú hàng hóa
  quantity        Decimal   @default(0) // Số lượng
  unitPrice       Decimal   @default(0) @map("unit_price") // Đơn giá
  discountPercent Decimal?  @default(0) @map("discount_percent") // Giảm giá %
  discountAmount  Decimal?  @default(0) @map("discount_amount") // Giảm giá
  salePrice       Decimal?  @map("sale_price") // Giá bán
  totalPrice      Decimal   @default(0) @map("total_price") // Thành tiền
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_item")
}

model InvoiceEInvoice {
  id         BigInt    @id @default(autoincrement())
  invoiceId  BigInt    @map("invoice_id")
  provider   String?
  externalId String?   @map("external_id")
  signed     Boolean?  @default(false)
  pdfUrl     String?   @map("pdf_url")
  xmlContent String?   @map("xml_content")
  issuedAt   DateTime? @map("issued_at") @db.Timestamptz
  status     String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@map("invoice_einvoice")
}

model Order {
  id             BigInt    @id @default(autoincrement())
  orderNumber    String?   @unique @map("order_number")
  storeId        BigInt?   @map("store_id")
  customerId     BigInt?   @map("customer_id")
  channel        String?
  status         String    @default("PENDING")
  totalAmount    Decimal   @default(0) @map("total_amount")
  subtotal       Decimal   @default(0)
  taxAmount      Decimal?  @default(0) @map("tax_amount")
  discountAmount Decimal?  @default(0) @map("discount_amount")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @map("updated_at") @db.Timestamptz

  store      Store?      @relation(fields: [storeId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  invoices   Invoice[]
  orderItems OrderItem[]
  payments   Payment[]

  @@map("order")
}

model OrderItem {
  id         BigInt  @id @default(autoincrement())
  orderId    BigInt  @map("order_id")
  variantId  BigInt  @map("variant_id")
  quantity   Decimal @db.Decimal(15, 3)
  unitPrice  Decimal @map("unit_price")
  totalPrice Decimal @map("total_price")
  discount   Decimal? @default(0)

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_item")
}

model Payment {
  id        BigInt    @id @default(autoincrement())
  orderId   BigInt?   @map("order_id")
  amount    Decimal
  method    String?
  status    String    @default("PENDING")
  reference String?
  paidAt    DateTime? @map("paid_at") @db.Timestamptz

  order Order? @relation(fields: [orderId], references: [id])

  @@map("payment")
}

model Product {
  id           BigInt    @id @default(autoincrement())
  sku          String?   @unique
  name         String
  description  String?
  categoryId   BigInt?   @map("category_id")
  defaultPrice Decimal   @default(0) @map("default_price")
  defaultCost  Decimal?  @default(0) @map("default_cost")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz

  // New fields from Excel import format
  productType         String?   @default("GOODS") @map("product_type") // GOODS, SERVICE, COMBO
  barcode             String?   // Mã vạch
  brand               String?   // Thương hiệu
  unit                String?   @default("Cái") // ĐVT
  baseUnitCode        String?   @map("base_unit_code") // Mã ĐVT cơ bản
  conversionRate      Decimal?  @default(1) @map("conversion_rate") // Quy đổi
  minStock            Int?      @default(0) @map("min_stock") // Tồn nhỏ nhất
  maxStock            Int?      @map("max_stock") // Tồn lớn nhất
  weight              Decimal?  // Trọng lượng
  location            String?   // Vị trí
  images              String?   // Hình ảnh (url1,url2...)
  attributes          Json?     // Thuộc tính
  relatedProductCodes String?   @map("related_product_codes") // Mã HH liên quan
  noteTemplate        String?   @map("note_template") // Mẫu ghi chú
  componentProducts   Json?     @map("component_products") // Hàng thành phần (for COMBO)
  
  // Business flags
  active              Boolean   @default(true) // Đang kinh doanh
  directSale          Boolean   @default(true) @map("direct_sale") // Được bán trực tiếp
  
  // Supplier reference (optional)
  supplierId          BigInt?   @map("supplier_id")

  category Category?        @relation(fields: [categoryId], references: [id])
  supplier Supplier?        @relation(fields: [supplierId], references: [id])
  variants ProductVariant[]
  productPrices ProductPrice[] // Price list prices

  @@map("product")
}

model ProductVariant {
  id         BigInt    @id @default(autoincrement())
  productId  BigInt    @map("product_id")
  sku        String?
  barcode    String?
  attributes Json?
  price      Decimal?
  cost       Decimal?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime? @map("updated_at") @db.Timestamptz

  product        Product         @relation(fields: [productId], references: [id])
  inventory      Inventory[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]

  @@unique([productId, sku])
  @@map("product_variant")
}

model Role {
  id          BigInt  @id @default(autoincrement())
  code        String  @unique
  name        String?
  description String?

  userRoles UserRole[]

  @@map("role")
}

model StockMovement {
  id              BigInt   @id @default(autoincrement())
  movementType    String   @map("movement_type")
  reference       String?
  referenceType   String?  @map("reference_type")
  referenceId     BigInt?  @map("reference_id")
  referenceCode   String?  @map("reference_code")
  variantId       BigInt   @map("variant_id")
  fromWarehouseId BigInt?  @map("from_warehouse_id")
  toWarehouseId   BigInt?  @map("to_warehouse_id")
  quantity        Decimal  @db.Decimal(15, 3)
  displayQuantity Decimal? @map("display_quantity") @db.Decimal(15, 3)
  displayUnit     String?  @map("display_unit")
  unitCost        Decimal? @map("unit_cost")
  performedBy     BigInt?  @map("performed_by")
  performedAt     DateTime @default(now()) @map("performed_at") @db.Timestamptz
  note            String?
  storeId         BigInt?  @map("store_id")


  variant       ProductVariant @relation(fields: [variantId], references: [id])
  fromWarehouse Warehouse?     @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse?     @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  performer     User?          @relation(fields: [performedBy], references: [id])
  store         Store?         @relation(fields: [storeId], references: [id])

  @@map("stock_movement")
}

model Store {
  id        BigInt    @id @default(autoincrement())
  code      String?   @unique
  name      String
  address   String?
  taxNumber String?   @map("tax_number")
  phone     String?
  email     String?
  settings  Json?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @map("updated_at") @db.Timestamptz

  bankAccounts   BankAccount[]
  invoices       Invoice[]
  orders         Order[]
  warehouses     Warehouse[]
  stockMovements StockMovement[]

  @@map("store")
}

model Supplier {
  id        BigInt   @id @default(autoincrement())
  code      String?  @unique
  name      String
  email     String?
  phone     String?
  address   String?
  taxNumber String?  @map("tax_number")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Thông tin từ Excel
  area                     String?   // Khu vực
  ward                     String?   // Phường/Xã
  notes                    String?   // Ghi chú
  supplierGroup            String?   @map("supplier_group") // Nhóm nhà cung cấp
  company                  String?   // Công ty
  creator                  String?   // Người tạo
  
  // Thống kê tài chính (có thể import từ Excel hoặc tự tính)
  totalPurchase            Decimal?  @map("total_purchase") // Tổng mua
  currentDebt              Decimal?  @map("current_debt") // Nợ cần trả hiện tại
  totalPurchaseAfterReturn Decimal?  @map("total_purchase_after_return") // Tổng mua trừ trả hàng
  
  // Trạng thái
  active    Boolean  @default(true) // Trạng thái: true=Đang hoạt động, false=Ngừng hoạt động

  purchaseOrders  PurchaseOrder[]
  payments        SupplierPayment[]
  products        Product[]

  @@map("supplier")
}

model SupplierPayment {
  id          BigInt   @id @default(autoincrement())
  code        String?  @unique // Mã phiếu chi
  supplierId  BigInt   @map("supplier_id")
  amount      Decimal
  method      String?  // CASH, TRANSFER
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  // Optional: Link to specific PO if strict allocation is used, 
  // but usually one payment pays for multiple orders or general debt.
  // For now, keep it simple as general payment.

  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  allocations SupplierPaymentAllocation[]

  @@map("supplier_payment")
}

model PurchaseOrder {
  id            BigInt    @id @default(autoincrement())
  orderNumber   String?   @unique @map("order_number")
  supplierId    BigInt    @map("supplier_id")
  warehouseId   BigInt?   @map("warehouse_id")
  status        String    @default("PENDING")
  totalAmount   Decimal   @default(0) @map("total_amount")
  discountAmount Decimal? @default(0) @map("discount_amount")
  amountPaid    Decimal   @default(0) @map("amount_paid")
  amountDue     Decimal?  @map("amount_due")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz

  supplier      Supplier        @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse?      @relation(fields: [warehouseId], references: [id])
  purchaseItems PurchaseItem[]
  paymentAllocations SupplierPaymentAllocation[]

  @@map("purchase_order")
}

model SupplierPaymentAllocation {
  id              BigInt   @id @default(autoincrement())
  paymentId       BigInt   @map("payment_id")
  purchaseOrderId BigInt   @map("purchase_order_id")
  amount          Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment       SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([paymentId, purchaseOrderId])
  @@index([paymentId])
  @@index([purchaseOrderId])
  @@map("supplier_payment_allocation")
}

model PurchaseItem {
  id              BigInt  @id @default(autoincrement())
  purchaseOrderId BigInt  @map("purchase_order_id")
  variantId       BigInt  @map("variant_id")
  quantity        Decimal @db.Decimal(15, 3)
  unitCost        Decimal @map("unit_cost")
  unit            String?
  totalCost       Decimal @map("total_cost")

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@map("purchase_item")
}

model Transaction {
  id          BigInt   @id @default(autoincrement())
  relatedType String?  @map("related_type")
  relatedId   BigInt?  @map("related_id")
  amount      Decimal
  gateway     String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  metadata    Json?

  @@map("transaction")
}

model UserRole {
  userId     BigInt   @map("user_id")
  roleId     BigInt   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_role")
}

model Warehouse {
  id        BigInt    @id @default(autoincrement())
  storeId   BigInt?   @map("store_id")
  code      String?
  name      String
  address   String?
  
  // New fields
  manager   String?   // Người quản lý
  active    Boolean   @default(true) // Trạng thái hoạt động
  notes     String?   // Ghi chú
  
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  store Store? @relation(fields: [storeId], references: [id])

  inventory          Inventory[]
  stockMovementsFrom StockMovement[] @relation("FromWarehouse")
  stockMovementsTo   StockMovement[] @relation("ToWarehouse")
  purchaseOrders     PurchaseOrder[]

  @@map("warehouse")
}

// Price Lists - Multiple pricing tiers
model PriceList {
  id          BigInt   @id @default(autoincrement())
  name        String   // "Giá bán lẻ", "Giá sỉ", "Giá VIP"
  code        String   @unique // "RETAIL", "WHOLESALE", "VIP"
  description String?
  isDefault   Boolean  @default(false) @map("is_default") // Default price list for POS
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  productPrices ProductPrice[]

  @@map("price_list")
}

// Product-specific prices for each price list
model ProductPrice {
  id          BigInt   @id @default(autoincrement())
  productId   BigInt   @map("product_id")
  priceListId BigInt   @map("price_list_id")
  price       Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([productId, priceListId]) // One price per product per price list
  @@map("product_price")
}
